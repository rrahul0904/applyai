FROM mcr.microsoft.com/playwright:v1.54.2-noble

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV CI="1"
ENV PLAYWRIGHT_BROWSERS_PATH="/ms-playwright"

WORKDIR /workspace

RUN corepack enable && corepack prepare pnpm@10.13.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json apps/web/package.json

# The worker imports @playwright/test directly; keep the web package's pinned
# dev dependency installed. Browser binaries and OS dependencies come from the
# matching official Playwright image above.
RUN pnpm install --frozen-lockfile --filter @applyai/web... --prod=false

COPY apps/web apps/web

WORKDIR /workspace/apps/web

CMD ["pnpm", "application-worker"]
