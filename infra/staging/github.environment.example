# GitHub Environment: staging
# Store these as GitHub environment variables, not repository secrets.
# Values below are placeholders only. Do not commit credentials or private data.

AWS_REGION=us-east-1
AWS_DEPLOY_ROLE_ARN=arn:aws:iam::123456789012:role/applyai-staging-github-deploy
TF_STATE_BUCKET=applyai-terraform-state-123456789012-us-east-1

WEB_ORIGIN=https://staging.example.com
API_BASE_URL=https://api.staging.example.com
API_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/REPLACE_ME

CLERK_ISSUER=https://REPLACE_ME.clerk.accounts.dev
CLERK_JWKS_URL=https://REPLACE_ME.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=applyai-staging-api

# JSON arrays of reviewed public ATS board/site identifiers. These are not secrets.
# Keep the first real staging set small: no more than five entries per provider.
# Use [] for a provider only when another provider has at least one reviewed source.
GREENHOUSE_BOARD_TOKENS=["example-board"]
LEVER_SITE_NAMES=["example-site"]
ASHBY_BOARD_NAMES=["example-board"]
