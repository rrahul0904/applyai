{
  "name": "applyai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "build": "pnpm --dir apps/web build",
    "lint": "pnpm --dir apps/web lint",
    "test:web": "pnpm --dir apps/web test",
    "test:e2e": "pnpm --dir apps/web test:e2e",
    "test:e2e:cleanroom": "pnpm --dir apps/web exec playwright test --config=playwright.cleanroom.config.ts",
    "local:certify": "bash scripts/local-certify.sh",
    "job-supply:acceptance": "uv run --project services/api python -m scripts.job_supply_acceptance",
    "job-supply:acceptance:report": "uv run --project services/api python -m scripts.job_supply_acceptance --allow-blocked",
    "job-supply:initial-acceptance": "uv run --project services/api python -m scripts.job_supply_initial_acceptance",
    "job-supply:initial-acceptance:report": "uv run --project services/api python -m scripts.job_supply_initial_acceptance --allow-blocked",
    "agent:demo": "uv run --project services/api python -m scripts.agent_demo",
    "agent:acceptance": "uv run --project services/api python -m scripts.agent_acceptance",
    "agent:acceptance:report": "uv run --project services/api python -m scripts.agent_acceptance --allow-blocked",
    "agent:scale": "uv run --project services/api python -m scripts.benchmark_agent_runtime",
    "dev:api": "uv run --project services/api uvicorn app.main:app --reload --port 8000",
    "test:api": "uv run --project services/api pytest",
    "openapi:export": "uv run --project services/api python services/api/scripts/export_openapi.py > apps/web/.openapi.json",
    "openapi:generate": "pnpm openapi:export && pnpm --dir apps/web exec openapi-typescript .openapi.json -o lib/api/schema.d.ts && rm apps/web/.openapi.json",
    "openapi:check": "pnpm openapi:generate && git diff --exit-code -- apps/web/lib/api/schema.d.ts",
    "test": "pnpm test:web && pnpm test:api",
    "dev:full": "bash scripts/dev-full.sh",
    "test:full": "bash scripts/local-certify.sh",
    "release:contract": "python3 scripts/verify_full_functional_contract.py",
    "release:predeploy-certify": "bash scripts/predeploy-certify.sh"
  }
}
