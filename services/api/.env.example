# Development defaults. Staging/production must override the durable-service settings below.
ENVIRONMENT=development

# Local/dev/CI may provide DATABASE_URL directly. ECS staging/production should instead
# provide all five DATABASE_* components below; when host/name/user/password are complete,
# the API constructs the Psycopg URL at runtime and overrides DATABASE_URL. Inject
# DATABASE_USER and DATABASE_PASSWORD from Secrets Manager rather than Terraform variables.
DATABASE_URL=postgresql+psycopg://applyai:applyai@localhost:55432/applyai
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

AUTH_PROVIDER=clerk
DEV_AUTH_ENABLED=false
DEV_AUTH_SECRET=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=

# Separate operator authentication for /api/v1/internal/* routes. This is not a Clerk
# candidate token and must be stored in Secrets Manager/GitHub/Vercel secret storage.
# When configured it must be at least 24 characters.
INTERNAL_API_TOKEN=

# Staging/production: OBJECT_STORAGE_PROVIDER=s3 and S3_BUCKET are required.
# S3_ENDPOINT_URL/S3_ADDRESSING_STYLE exist for explicit emulator/test endpoints; production
# leaves them blank/auto so boto3 resolves normal AWS endpoints.
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/resumes
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_ADDRESSING_STYLE=auto
S3_UPLOAD_EXPIRATION_SECONDS=900
MAX_RESUME_BYTES=5242880

# Staging/production uses three task families:
# - SQS_QUEUE_URL / SQS_DLQ_URL: resume processing
# - SOURCE_SQS_*: job-source discovery/ingestion/verification
# - AI_SQS_*: Career Intelligence V2 model work
# Dedicated source/AI task families fail closed when their queue URL is absent.
# SQS_ENDPOINT_URL is an explicit emulator override used by the local clean-room gate; normal
# AWS environments leave it unset.
TASK_QUEUE_PROVIDER=memory
SQS_ENDPOINT_URL=
SQS_QUEUE_URL=
SQS_DLQ_URL=
SOURCE_SQS_QUEUE_URL=
SOURCE_SQS_DLQ_URL=
AI_SQS_QUEUE_URL=
AI_SQS_DLQ_URL=
SQS_REGION=us-east-1
SQS_VISIBILITY_TIMEOUT_SECONDS=300
SQS_VISIBILITY_HEARTBEAT_SECONDS=120
SOURCE_SQS_VISIBILITY_TIMEOUT_SECONDS=900
SOURCE_SQS_VISIBILITY_HEARTBEAT_SECONDS=300
AI_SQS_VISIBILITY_TIMEOUT_SECONDS=600
AI_SQS_VISIBILITY_HEARTBEAT_SECONDS=240
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_RECEIVE_COUNT=5
SOURCE_SQS_MAX_RECEIVE_COUNT=5
AI_SQS_MAX_RECEIVE_COUNT=5
RESUME_PROCESSING_TIMEOUT_SECONDS=900

OUTBOX_BATCH_SIZE=25
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_LOCK_TIMEOUT_SECONDS=300

# Career Intelligence V2. Development and CI use the deterministic evidence-safe provider.
# It is explicitly a test/baseline engine, not an LLM. Set AI_PROVIDER=openai only in a
# reviewed environment with OPENAI_API_KEY injected from secret storage. No key belongs in
# source control, Terraform variables, client-side environment, logs, or AIJobRun payloads.
AI_PROVIDER=deterministic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=low
AI_REQUEST_TIMEOUT_SECONDS=60
# Pricing inputs are configuration, not hard-coded billing claims. Keep them synchronized
# with the reviewed provider/model before using estimated_cost_usd operationally.
AI_INPUT_COST_PER_MILLION_USD=1
AI_OUTPUT_COST_PER_MILLION_USD=6

# Semantic job matching uses a deterministic local embedding provider in development/CI.
# Deployment may opt into OpenAI embeddings using the same server-side OpenAI secret boundary.
EMBEDDING_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Billing source is complete but external checkout remains disabled unless Stripe is configured.
# STRIPE_API_BASE_URL is only an explicit compatible/test endpoint override; production leaves it
# unset and uses https://api.stripe.com.
BILLING_PROVIDER=internal
STRIPE_API_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Transactional notification email. Disabled is safe by default. The local clean-room gate sets
# EMAIL_PROVIDER=smtp and points these values at Mailpit. A deployed SMTP relay must use secrets.
EMAIL_PROVIDER=disabled
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=no-reply@applyai.local

# Public ATS source bootstrap. Values are JSON arrays of public board/site identifiers.
GREENHOUSE_BOARD_TOKENS=[]
LEVER_SITE_NAMES=[]
ASHBY_BOARD_NAMES=[]

JOB_UNKNOWN_AFTER_MISSES=1
JOB_STALE_AFTER_MISSES=3
JOB_SOURCE_CLAIM_BATCH_SIZE=10
JOB_SOURCE_DISPATCH_BATCH_SIZE=25
JOB_SOURCE_MAX_INFLIGHT=250
JOB_SOURCE_LEASE_SECONDS=900
JOB_SOURCE_DEFAULT_INTERVAL_SECONDS=21600
JOB_SOURCE_MIN_INTERVAL_SECONDS=900
JOB_SOURCE_MAX_INTERVAL_SECONDS=604800
JOB_SOURCE_FAILURE_MAX_BACKOFF_SECONDS=604800
JOB_SOURCE_REQUEST_TIMEOUT_SECONDS=20
JOB_SOURCE_MAX_PAGES=20

# Career discovery fetches public HTTP/HTTPS pages only. Every redirect is revalidated;
# private/loopback/link-local destinations are blocked. These are decompressed byte/page
# budgets, not target throughput controls. Generic extraction does not execute JavaScript.
# ATS detection covers Greenhouse, Lever, Ashby, Workday, SmartRecruiters, Workable, iCIMS,
# Oracle and SuccessFactors; unsupported board APIs still use the safe structured-page path.
CAREER_DISCOVERY_MAX_PAGES=8
CAREER_DISCOVERY_MAX_BYTES=2097152
CAREER_DISCOVERY_MAX_REDIRECTS=4
CAREER_DISCOVERY_TIMEOUT_SECONDS=12
CAREER_DISCOVERY_MIN_SOURCE_CONFIDENCE=0.80
CAREER_DISCOVERY_REFRESH_INTERVAL_SECONDS=604800

APPLY_URL_CHECK_BATCH_SIZE=50
APPLY_URL_VALID_INTERVAL_SECONDS=604800
APPLY_URL_ERROR_INTERVAL_SECONDS=86400
APPLY_URL_NOT_FOUND_CONFIRMATIONS=2
RAW_JOB_PAYLOAD_RETENTION_DAYS=90

# Staging/production must use the exact HTTPS web origin; wildcard CORS is rejected.
WEB_ORIGIN=http://localhost:3000
# Additional exact HTTPS origins, encoded as JSON. Use this for Vercel Preview alongside Production.
WEB_ORIGINS=[]
SEED_DEVELOPMENT_JOBS=false
