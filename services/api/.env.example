# Development defaults. Staging/production must override the durable-service settings below.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://applyai:applyai@localhost:55432/applyai
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

AUTH_PROVIDER=clerk
DEV_AUTH_ENABLED=false
DEV_AUTH_SECRET=
CLERK_ISSUER=
CLERK_JWKS_URL=
CLERK_AUDIENCE=

# Staging/production: OBJECT_STORAGE_PROVIDER=s3 and S3_BUCKET are required.
# The bucket must remain private and its CORS policy must allow PUT from WEB_ORIGIN
# with Content-Type and x-amz-server-side-encryption headers.
OBJECT_STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=.data/resumes
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=
S3_UPLOAD_EXPIRATION_SECONDS=900
MAX_RESUME_BYTES=5242880

# Staging/production: TASK_QUEUE_PROVIDER=sqs, SQS_QUEUE_URL, and SQS_DLQ_URL are required.
# Configure the SQS redrive policy with maxReceiveCount matching SQS_MAX_RECEIVE_COUNT.
# The application does not emulate redrive; AWS owns moving exhausted messages to the DLQ.
# The worker extends visibility while processing and treats RESUME_PROCESSING_TIMEOUT_SECONDS
# as the durable stale-attempt lease used to recover abandoned processing attempts.
TASK_QUEUE_PROVIDER=memory
SQS_QUEUE_URL=
SQS_DLQ_URL=
SQS_REGION=us-east-1
SQS_VISIBILITY_TIMEOUT_SECONDS=300
SQS_VISIBILITY_HEARTBEAT_SECONDS=120
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_RECEIVE_COUNT=5
RESUME_PROCESSING_TIMEOUT_SECONDS=900

# Run a dedicated task-outbox publisher alongside the API and resume worker.
OUTBOX_BATCH_SIZE=25
OUTBOX_RETRY_BASE_SECONDS=5
OUTBOX_LOCK_TIMEOUT_SECONDS=300

# Greenhouse source freshness: one complete successful board pass increments misses.
# A failed or partial connector run never changes freshness state.
JOB_UNKNOWN_AFTER_MISSES=1
JOB_STALE_AFTER_MISSES=3
GREENHOUSE_BOARD_TOKENS=[]

# Staging/production must use the exact HTTPS web origin; wildcard CORS is rejected.
WEB_ORIGIN=http://localhost:3000
SEED_DEVELOPMENT_JOBS=false
