# ApplyAI Job Data Platform environment additions.
# Merge these values into the normal services/api/.env.example configuration.

# Reviewed public ATS board/site identifiers. These are JSON arrays, not credentials.
GREENHOUSE_BOARD_TOKENS=[]
LEVER_SITE_NAMES=[]
ASHBY_BOARD_NAMES=[]

# Official public job APIs. Never commit real secrets/API keys.
# USAJOBS requires an issued API key and a registered/user-contact email in User-Agent.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
# ReliefWeb v2 requires a pre-approved appname for production use.
RELIEFWEB_APPNAME=

# Source schedulers/workers can be horizontally partitioned without duplicating a source.
# Each scheduler instance must use the same count and a unique index in [0, count-1].
JOB_SOURCE_SHARD_COUNT=1
JOB_SOURCE_SHARD_INDEX=0

# Dedicated source queue. In local development these may remain empty and source
# tasks fall back to the in-memory source queue. Staging must provision both.
SOURCE_SQS_QUEUE_URL=
SOURCE_SQS_DLQ_URL=
SOURCE_SQS_VISIBILITY_TIMEOUT_SECONDS=900
SOURCE_SQS_VISIBILITY_HEARTBEAT_SECONDS=300
SOURCE_SQS_MAX_RECEIVE_COUNT=5

# Bounded transactional dispatcher and PostgreSQL lease backpressure.
JOB_SOURCE_DISPATCH_BATCH_SIZE=25
JOB_SOURCE_MAX_INFLIGHT=250
JOB_SOURCE_MIN_INTERVAL_SECONDS=900
JOB_SOURCE_DEFAULT_INTERVAL_SECONDS=21600
JOB_SOURCE_MAX_INTERVAL_SECONDS=604800
JOB_SOURCE_FAILURE_MAX_BACKOFF_SECONDS=604800

# Apply-link verification never submits an application. Repeated 404/410 evidence is
# required before a source is explicitly confirmed closed.
APPLY_URL_CHECK_BATCH_SIZE=50
APPLY_URL_VALID_INTERVAL_SECONDS=604800
APPLY_URL_ERROR_INTERVAL_SECONDS=86400
APPLY_URL_NOT_FOUND_CONFIRMATIONS=2

# Keep the newest raw payload for every source. Remove only older duplicate payloads
# after this period. S3 archival remains deferred until database growth is measured.
RAW_JOB_PAYLOAD_RETENTION_DAYS=90

# Career-site discovery remains plain public HTTP/HTTPS with SSRF and crawl budgets.
CAREER_DISCOVERY_MAX_PAGES=8
CAREER_DISCOVERY_MAX_BYTES=2097152
CAREER_DISCOVERY_MAX_REDIRECTS=4
CAREER_DISCOVERY_TIMEOUT_SECONDS=12
CAREER_DISCOVERY_MIN_SOURCE_CONFIDENCE=0.80
CAREER_DISCOVERY_REFRESH_INTERVAL_SECONDS=604800
