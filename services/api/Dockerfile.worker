FROM mcr.microsoft.com/playwright:v1.54.2-noble

COPY --from=ghcr.io/astral-sh/uv:0.11.32 /uv /uvx /bin/

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_NO_DEV=1 \
    PATH="/app/.venv/bin:$PATH" \
    PLAYWRIGHT_BROWSERS_PATH="/ms-playwright" \
    CI="1"

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-install-project

COPY alembic.ini ./
COPY alembic ./alembic
COPY app ./app
COPY scripts ./scripts

RUN npm install --no-save playwright@1.54.2 \
    && chmod +x /app/scripts/run_combined_worker.sh \
    && useradd --system --uid 10001 --create-home --home-dir /app applyai \
    && chown -R applyai:applyai /app

USER applyai

CMD ["/app/scripts/run_combined_worker.sh"]
